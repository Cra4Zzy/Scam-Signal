# ScamSignal -> Supabase
# Diese Datei als .env.local kopieren. Keine echten Secret Keys in GitHub hochladen.

NEXT_PUBLIC_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_DEIN_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Für lokale Registrierung, Evidence-Uploads und Server-Admin-Funktionen.
# Bevorzugt: der neue Supabase Secret Key (sb_secret_...).
SUPABASE_SECRET_KEY=sb_secret_DEIN_SECRET_KEY

# Alternativ wird auch der ältere service_role Key akzeptiert.
# SUPABASE_SERVICE_ROLE_KEY=DEIN_SERVICE_ROLE_KEY
